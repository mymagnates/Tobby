{
  "name": "project_handout",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Handout",
  "author": "Magnates Solution <mymagnates@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "favicons": "node generate-favicons.js",
    "prebuild": "npm run favicons",
    "predev": "npm run favicons",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit --reporter=verbose",
    "test:api": "vitest run tests/unit/backend --reporter=verbose",
    "test:rules": "firebase emulators:exec --project handout-ci --only auth,firestore,storage \"vitest run tests/rules --reporter=verbose\"",
    "test:e2e": "node tests/e2e/assertEnvironment.js full && playwright test --config tests/e2e/playwright.config.js --project=chromium",
    "test:e2e:webkit": "node tests/e2e/assertEnvironment.js full && playwright test --config tests/e2e/playwright.config.js --project=webkit",
    "test:smoke:staging": "node tests/e2e/assertEnvironment.js smoke && playwright test --config tests/e2e/playwright.config.js --project=chromium --grep @smoke",
    "test:release": "node tests/e2e/assertEnvironment.js lighthouse && lhci autorun",
    "dev": "quasar dev",
    "api:dev": "node backend/server.js",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "chart.js": "^4.5.0",
    "firebase": "^12.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "vue": "^3.4.18",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@quasar/app-vite": "^2.1.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "firebase-tools": "^15.24.0",
    "globals": "^15.12.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "sharp": "^0.34.4",
    "vite-plugin-checker": "^0.9.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
