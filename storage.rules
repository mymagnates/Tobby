rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function propertyPath(propertyId) {
      return /databases/(default)/documents/properties/$(propertyId);
    }

    function isPropertyReadMember(propertyId) {
      return isSignedIn()
        && firestore.exists(propertyPath(propertyId))
        && (
          (firestore.get(propertyPath(propertyId)).data.owner_user_ids is list
            && request.auth.uid in firestore.get(propertyPath(propertyId)).data.owner_user_ids)
          || (firestore.get(propertyPath(propertyId)).data.manager_user_ids is list
            && request.auth.uid in firestore.get(propertyPath(propertyId)).data.manager_user_ids)
          || (firestore.get(propertyPath(propertyId)).data.viewer_user_ids is list
            && request.auth.uid in firestore.get(propertyPath(propertyId)).data.viewer_user_ids)
        );
    }

    function isPropertyWriteMember(propertyId) {
      return isSignedIn()
        && firestore.exists(propertyPath(propertyId))
        && (
          (firestore.get(propertyPath(propertyId)).data.owner_user_ids is list
            && request.auth.uid in firestore.get(propertyPath(propertyId)).data.owner_user_ids)
          || (firestore.get(propertyPath(propertyId)).data.manager_user_ids is list
            && request.auth.uid in firestore.get(propertyPath(propertyId)).data.manager_user_ids)
        );
    }

    function leasePropertyId(leaseId) {
      return firestore.get(/databases/(default)/documents/leases/$(leaseId)).data.property_string_id;
    }

    function isLeasePropertyMember(leaseId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/leases/$(leaseId))
        && isPropertyReadMember(leasePropertyId(leaseId));
    }

    function isLeasePropertyWriteMember(leaseId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/leases/$(leaseId))
        && isPropertyWriteMember(leasePropertyId(leaseId));
    }

    match /properties/{propertyId}/{allPaths=**} {
      allow read: if isPropertyReadMember(propertyId);
      allow delete: if isPropertyWriteMember(propertyId);
    }

    match /images/{context}/{propertyId}/{allPaths=**} {
      allow read: if isPropertyReadMember(propertyId);
      allow delete: if isPropertyWriteMember(propertyId);
    }

    // This path remains conditional on the existing lease document and will be
    // disabled when lease documents move behind the Lease Domain API.
    match /images/leases/{leaseId}/{allPaths=**} {
      allow read: if isLeasePropertyMember(leaseId);
      allow delete: if isLeasePropertyWriteMember(leaseId);
    }

    // Sensitive lease application documents are only accessed through backend-issued
    // signed URLs after application-level authorization checks.
    match /secure/lease_applications/{allPaths=**} {
      allow read, write: if false;
    }

    // Keep marketplace and user media private until their API migration lands.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
